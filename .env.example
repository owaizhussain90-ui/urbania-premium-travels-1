VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Public, browser-restricted key (HTTP referrer restricted in Google Cloud). Enables Places autocomplete.
VITE_GOOGLE_MAPS_KEY=
# Operator contact shown in the app
VITE_OPERATOR_PHONE=+919999999999
VITE_OPERATOR_WHATSAPP=919999999999

# --- Server-side only: set these as Supabase Edge Function secrets, NEVER in the frontend ---
# supabase secrets set SMS_PROVIDER=msg91 MSG91_AUTH_KEY=... MSG91_SENDER=URBNIA MSG91_TEMPLATE_ID=...
# supabase secrets set GOOGLE_MAPS_SERVER_KEY=...   (Distance Matrix, used by estimate-route function)
# supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=...
